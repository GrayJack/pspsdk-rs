{
    "files.watcherExclude": {
        "**/target": true
    },
    "rust-analyzer.cargo.cfgs": [
        "debug_assertions",
        "miri",
        "doc",
        // "prx",
        // "pbp"
        // "eboot"
        // "pboot"
    ],
    "rust-analyzer.cargo.features": [
        "kernel"
